# Replace every placeholder with a unique secret before deployment.
DATABASE_URL="postgresql://schoolcrm:replace-with-unique-db-password@localhost:5432/schoolcrm?schema=public"
POSTGRES_PASSWORD="replace-with-unique-db-password"
JWT_SECRET="replace-with-random-secret-at-least-32-bytes"
BOOTSTRAP_ADMIN_KEY="replace-with-a-separate-random-one-time-setup-key"
WEB_ORIGIN="http://localhost:3100"
TRUST_PROXY_HOPS=0
API_PORT=4000
WEB_PORT=8080
NEXT_PUBLIC_API_URL="/api"
LIVEKIT_API_KEY="replace-with-random-livekit-key"
LIVEKIT_API_SECRET="replace-with-random-livekit-secret-at-least-32-characters"
LIVEKIT_PUBLIC_URL="wss://school.example/livekit"
LIVEKIT_NODE_IP="192.168.1.10"
